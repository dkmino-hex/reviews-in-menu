meta {
  name: Change Password
  type: http
  seq: 3
}

patch {
  url: {{baseURL}}/me
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Test User",
    "currentPassword": "Test123456",
    "newPassword": "NewTest123456"
  }
}

assert {
  res.status: eq 204
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  После смены пароля все сеансы завершаются. Повторно войди с новым паролем.
}

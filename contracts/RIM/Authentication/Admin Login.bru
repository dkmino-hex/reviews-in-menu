meta {
  name: Admin Login
  type: http
  seq: 3
}

post {
  url: {{baseURL}}/auth/login
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "login": "YOUR_ADMIN_LOGIN",
    "password": "YOUR_ADMIN_PASSWORD"
  }
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Впиши логин и пароль существующего администратора локально. Не коммить реальные пароли.
  Вход заменяет текущую cookie. Для отзывов затем снова выполни Login посетителя.
}

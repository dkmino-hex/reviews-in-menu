meta {
  name: Edit Review
  type: http
  seq: 3
}

patch {
  url: {{baseURL}}/me/reviews/{{reviewId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "rating": 4,
    "body": "Соус вкусный, но порция небольшая.",
    "version": {{reviewVersion}}
  }
}

assert {
  res.status: eq 204
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Подставь актуальную reviewVersion из My Reviews. После изменения перечитай список.
  Устаревшая версия вернёт 409.
}

meta {
  name: Clear Helpfulness
  type: http
  seq: 8
}

put {
  url: {{baseURL}}/reviews/{{reviewId}}/helpfulness
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "vote": 0
  }
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Войди посетителем или администратором. Автор не может голосовать за свой комментарий. Повторный PUT не дублирует голос.
}

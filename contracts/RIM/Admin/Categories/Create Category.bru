meta {
  name: Create Category
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/admin/categories
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Тестовая категория"
  }
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Сохрани id созданной категории в categoryId.
}

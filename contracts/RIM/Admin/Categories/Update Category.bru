meta {
  name: Update Category
  type: http
  seq: 2
}

put {
  url: {{baseURL}}/admin/categories/{{categoryId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Тестовая категория — обновлено"
  }
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}
